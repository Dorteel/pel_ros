<owl:NamedIndividual rdf:about="#infer_camera_from_image">
  <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
  <swrl:body>
    <rdf:Description>
      <rdf:first>
        <swrl:ClassAtom>
          <swrl:classPredicate rdf:resource="#Sensor"/>
          <swrl:argument1 rdf:resource="urn:swrl#s"/>
        </swrl:ClassAtom>
      </rdf:first>
      <rdf:rest>
        <rdf:Description>
          <rdf:first>
            <swrl:IndividualPropertyAtom>
              <swrl:propertyPredicate rdf:resource="#hasBaseROSTopic"/>
              <swrl:argument1 rdf:resource="urn:swrl#s"/>
              <swrl:argument2 rdf:resource="urn:swrl#t"/>
            </swrl:IndividualPropertyAtom>
          </rdf:first>
          <rdf:rest>
            <rdf:Description>
              <rdf:first>
                <swrl:IndividualPropertyAtom>
                  <swrl:propertyPredicate rdf:resource="#hasMessageType"/>
                  <swrl:argument1 rdf:resource="urn:swrl#t"/>
                  <swrl:argument2 rdf:resource="urn:swrl#m"/>
                </swrl:IndividualPropertyAtom>
              </rdf:first>
              <rdf:rest>
                <rdf:Description>
                  <rdf:first>
                    <swrl:DatavaluedPropertyAtom>
                      <swrl:propertyPredicate rdf:resource="#hasROSName"/>
                      <swrl:argument1 rdf:resource="urn:swrl#m"/>
                      <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sensor_msgs/msg/Image</swrl:argument2>
                    </swrl:DatavaluedPropertyAtom>
                  </rdf:first>
                  <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                </rdf:Description>
              </rdf:rest>
            </rdf:Description>
          </rdf:rest>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </swrl:body>
  <swrl:head>
    <rdf:Description>
      <rdf:first>
        <swrl:ClassAtom>
          <swrl:classPredicate rdf:resource="#Camera"/>
          <swrl:argument1 rdf:resource="urn:swrl#s"/>
        </swrl:ClassAtom>
      </rdf:first>
      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    </rdf:Description>
  </swrl:head>
</owl:NamedIndividual>

